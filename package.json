{
  "name": "paykit",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "frontend",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "chain": "anvil --host 127.0.0.1 --port 8545 --silent",
    "contracts:build": "npm --prefix contracts run build",
    "contracts:test": "npm --prefix contracts run test",
    "sdk:build": "npm run build -w @paykit/core -w @paykit/observer -w @paykit/server -w @paykit/testing -w @paykit/js -w @paykit/node -w @paykit/next -w @paykit/react",
    "sdk:typecheck": "npm run typecheck -w @paykit/core -w @paykit/observer -w @paykit/server -w @paykit/testing -w @paykit/js -w @paykit/node -w @paykit/next -w @paykit/react",
    "sdk:test": "npm test -w @paykit/core -w @paykit/observer -w @paykit/js -w @paykit/node -w @paykit/next -w @paykit/server -w @paykit/react",
    "demo": "npm run dev --workspace demo-store",
    "server": "npm start -w @paykit/server",
    "server:demo": "npm run demo -w @paykit/server",
    "frontend": "npm run dev --workspace paykit-frontend",
    "frontend:build": "npm run build --workspace paykit-frontend",
    "sdk:registry": "node scripts/build-ui-registry.mjs",
    "sdk:consumer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-sdk-consumer.ps1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
