{
  "name": "@paykit/core",
  "version": "0.1.0",
  "description": "Shared types, chain config, EIP-712 signing formats, IDs and amount math for PayKit on Whitechain.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=source --test test/core.test.ts",
    "test:live": "node --conditions=source --test test/live.test.ts"
  },
  "dependencies": {
    "viem": "^2.47.6",
    "zod": "^4.0.0"
  }
}
