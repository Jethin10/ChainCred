{
  "name": "@paykit/next",
  "version": "0.1.0",
  "description": "Next.js App Router helpers for PayKit: webhook route and the merchant-data proxy for dashboard components.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=source --test test/*.test.ts"
  },
  "dependencies": {
    "@paykit/core": "0.1.0",
    "@paykit/node": "0.1.0"
  }
}
