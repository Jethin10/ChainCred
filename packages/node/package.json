{
  "name": "@paykit/node",
  "version": "0.1.0",
  "description": "Server SDK for PayKit: invoices, local quote signing with the merchant server key, refunds, plans and webhook verification.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "paykit-keygen": "./bin/keygen.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=source --test test/*.test.ts"
  },
  "dependencies": {
    "@paykit/core": "0.1.0",
    "viem": "^2.47.6",
    "zod": "^4.0.0"
  }
}
