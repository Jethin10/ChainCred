# PayKit API server. Copy to .env and fill in. Never commit .env.

# Run on a simulated chain with demo shops (no keys or contracts needed):
# DEMO=1

PORT=8787
NETWORK=whitechain-testnet
RPC_URL=https://rpc.testnet.whitechain.io
PUBLIC_URL=http://localhost:8787

# Your teammate's deployed contracts (Whitechain Sepolia, chain 1874)
ROUTER_ADDRESS=
REGISTRY_ADDRESS=
TREASURY_ADDRESS=

# Relay wallet: submits every transaction and pays the WBT gas. Fund it with test WBT.
RELAYER_KEY=
# Hosted signer: signs payment offers for merchants. Merchants authorize its address at sign-up.
SIGNER_KEY=
# Registry owner key, used to mark domains verified (defaults to RELAYER_KEY).
ADMIN_KEY=

# Comma-separated sites allowed to sign in (your web app's host, e.g. localhost:5174)
SIWE_DOMAINS=localhost:5174,localhost:5175

DATA_FILE=./data/paykit.sqlite
# First block of the configured deployment. Required in real mode.
DEPLOYMENT_BLOCK=
# Enable only after measuring payment cost and verifying the treasury interface.
REFILL_ENABLED=0
MEASURED_PAYMENT_COST_WBT=
RESERVE_WBT=0.02
TICK_MS=5000
