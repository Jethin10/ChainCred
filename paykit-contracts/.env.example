# ── chain (Whitechain Sepolia) ──
RPC_URL=https://rpc.testnet.whitechain.io
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
WWBT_ADDRESS=0x4200000000000000000000000000000000000006
SWAP_ROUTER02=0xe208cC685cD95D56E8ec6DEC9816476567fc6962
QUOTER_V2=0x90f28c3a6233713d6Df00E5fa92a3f13EFe36191
USDT_WWBT_POOL=0x5645101Ca8d2F7BaBC27b10359555767a1BdF999
POOL_FEE=3000

# ── deployer = contract owner. NEW testnet-only key, funded with WBT. Never commit. ──
PLATFORM_ADMIN_KEY=

# comma-separated relay node addresses (whitelisted in FeeTreasury). Defaults to the deployer.
RELAYER_ADDRESSES=
# comma-separated domain attestor addresses (the verifier worker). Defaults to none (admin can still attest).
ATTESTOR_ADDRESSES=

# ── fee schedule (USDT base units, 6 dp) ──
FEE_BPS=100
MIN_FEE=50000
MAX_FEE=25000000

# ── registry ──
PAYOUT_CHANGE_DELAY=0

# ── treasury refill limits ──
REFILL_MAX_PER_RUN=20000000
REFILL_MAX_PER_DAY=100000000
# wei of WBT per 1 USDT. Snapshot price ~0.01345 WBT/USDT; 80% of that = 0.01076 WBT
REFILL_MIN_WBT_PER_USDT=10760000000000000
REFILL_MAX_DEADLINE=120
RESERVED_USDT=0

# ── points (PaymentRouterV2 / PayKitPoints) ──
# platform-wide cap: at most this many points per 1 USDT paid
MAX_POINTS_PER_USDT=100
