# ── server ──
PORT=8787
# where the hosted checkout page will live (frontend, later). Pay links are CHECKOUT_BASE_URL/<invoiceId>
CHECKOUT_BASE_URL=http://localhost:3000/pay

# ── database (Neon Postgres) ──────────────────────────────────────────────
# Leave both empty to run with the in-memory store (data is lost on restart).
# Get them from Neon: Project -> Dashboard -> "Connect" -> pick your branch + database,
#   then copy BOTH strings (toggle "Connection pooling" ON for the first, OFF for the second).
#
# DATABASE_URL: the POOLED string (host has "-pooler" in it). Used for all normal queries.
#   format: postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL=
# DATABASE_URL_UNPOOLED: the DIRECT string (same, but WITHOUT "-pooler"). Used once at startup to create tables.
#   format: postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL_UNPOOLED=

# ── secrets (generate with: npm run gen-secrets) ──
# protects POST /v1/merchants and /v1/admin/* (Authorization: Bearer <ADMIN_TOKEN>)
ADMIN_TOKEN=
# 32-byte hex key that encrypts each merchant's hosted quote-signer key at rest
MASTER_KEY=

# ── chain ──
RPC_URL=https://rpc.testnet.whitechain.io
CHAIN_ID=1874
EXPLORER_URL=https://explorer.testnet.whitechain.io
# relayer = pays gas, and owns platform-hosted merchants. Same pool wallet as paykit-contracts/.env (PRIVATE key)
PLATFORM_ADMIN_KEY=

# ── contracts (from paykit-contracts/deployments/1874.json) ──
REGISTRY_ADDRESS=0xF6B60D212abd955a6d4937535f89B5B7b6426C47
ROUTER_ADDRESS=0xef2f926CF5D57098Ff3e57f65492b74Ac0E2b489
TREASURY_ADDRESS=0xeb52e2394ECFbAbFD53F9cF9e50F8c4bC35d84e2
DEPLOY_BLOCK=12317987
# points upgrade (from: npm run deploy:v2 in paykit-contracts). Leave empty to run without points.
ROUTER_V2_ADDRESS=
POINTS_ADDRESS=
DEPLOY_BLOCK_V2=
USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
WWBT_ADDRESS=0x4200000000000000000000000000000000000006
QUOTER_V2=0x90f28c3a6233713d6Df00E5fa92a3f13EFe36191
POOL_FEE=3000
# folder with the compiled contracts (ABIs) and scripts/lib/typedData.js
CONTRACTS_DIR=../paykit-contracts

# ── behaviour ──
QUOTE_TTL_SEC=600
MERCHANT_MAX_FEE_BPS=300
CONFIRMATIONS=2
OBSERVER_POLL_MS=3000
OBSERVER_CHUNK=2000
WEBHOOK_MAX_ATTEMPTS=8

# subscriptions: how often the scheduler looks for due charges, retry delay after a failed charge, default grace
SCHEDULER_POLL_MS=15000
CHARGE_RETRY_SEC=300
DEFAULT_GRACE_SEC=259200

# fee refill loop: convert treasury USDT to WBT only when it pays for itself
REFILL_ENABLED=true
REFILL_INTERVAL_MIN=30
REFILL_MIN_USDT=0.5
# run only if WBT received >= this many times the gas the refill costs
REFILL_PROFIT_MULTIPLE=3
REFILL_SLIPPAGE_BPS=200
