{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": { "includeFiles": "{contracts-bundle,src,sdk/dist}/**", "maxDuration": 60 }
  },
  "crons": [{ "path": "/api/cron", "schedule": "0 3 * * *" }]
}
